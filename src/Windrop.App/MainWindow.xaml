<Window x:Class="Windrop.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windrop" Width="980" Height="860" MinWidth="880" MinHeight="820" Background="#F5F8FC" Foreground="#142B44" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
  <Border Background="#F5F8FC">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="↗  windrop" FontSize="30" FontWeight="Bold"/><TextBlock Text="A little closer. A lot easier to share." Foreground="#63768B" Margin="0,7,0,0"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E5EDF7" CornerRadius="15" Padding="14,7"><TextBlock x:Name="ConnectionBadge" Text="Radio disconnected" FontSize="12" FontWeight="SemiBold"/></Border>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="16" Padding="24" BorderBrush="#E4EBF3" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Send something good" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose your files, then choose a nearby device." Foreground="#63768B" Margin="0,6,0,20"/></StackPanel>
          <Border Grid.Row="1" Background="#F4F8FD" BorderBrush="#BFCFE2" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,22">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="36" HorizontalAlignment="Center" Foreground="#3569C8"/><TextBlock x:Name="SelectionText" Text="Drop files here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Photos, documents, and folders" FontSize="12" Foreground="#63768B" HorizontalAlignment="Center"/><Button Content="Choose files" Click="ChooseFiles" Margin="0,15,0,0"/></StackPanel>
          </Border>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="NEARBY DEVICES" FontSize="11" FontWeight="Bold" Foreground="#63768B" Margin="0,0,0,12"/>
            <ListBox Grid.Row="1" x:Name="PeerList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="SelectionChanged" AutomationProperties.Name="Nearby devices">
              <ListBox.ItemTemplate><DataTemplate><Border Background="#EFF5FD" CornerRadius="8" Padding="14" Margin="0,3"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="AirDrop device · name is unverified" FontSize="11" Foreground="#63768B" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyPeers" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◎" FontSize="34" Foreground="#8BA4C1" HorizontalAlignment="Center"/><TextBlock Text="No devices yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Connect your radio to start looking." Foreground="#63768B" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,15,0,0"><ProgressBar x:Name="SendProgress" Height="4" Minimum="0" Maximum="100" Margin="0,0,0,12"/><Button x:Name="SendButton" Content="Send files" Foreground="White" Background="#3569C8" IsEnabled="False" Click="SendFiles"/></StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="2">
        <Border Background="White" CornerRadius="16" Padding="22" BorderBrush="#E4EBF3" BorderThickness="1"><StackPanel>
          <TextBlock Text="Your AirDrop radio" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A dedicated Wi-Fi adapter connects you to Apple devices." TextWrapping="Wrap" Foreground="#63768B" FontSize="12" Margin="0,8,0,18"/>
          <TextBlock Text="Radio host" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="HostInput" AutomationProperties.Name="Radio host"/>
          <TextBlock Text="Radio access key" FontSize="12" Margin="0,13,0,6"/><PasswordBox x:Name="KeyInput" Padding="10,9" BorderBrush="#D8E2EE" AutomationProperties.Name="Radio access key"/>
          <Button x:Name="ConnectButton" Content="Connect radio" Background="#142B44" Foreground="White" Click="ToggleConnection" Margin="0,18,0,0"/>
          <TextBlock x:Name="RadioMessage" Text="An AWDL radio is required. Set up a compatible USB adapter in WSL2 or connect a Linux radio." TextWrapping="Wrap" Foreground="#63768B" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel></Border>
        <Border Background="#EAF1FC" CornerRadius="16" Padding="22" Margin="0,18,0,0"><StackPanel>
          <TextBlock x:Name="ReceiveHeading" Text="Receive with approval" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="You approve each incoming transfer. Files go to Downloads\Windrop." TextWrapping="Wrap" Foreground="#63768B" FontSize="12" Margin="0,8,0,15"/><Button Content="Open downloads" Click="OpenDownloads" Background="White"/>
        </StackPanel></Border>
        <TextBlock Text="On your iPhone: turn on Wi-Fi and Bluetooth, then select Everyone for 10 Minutes in AirDrop." TextWrapping="Wrap" Foreground="#63768B" FontSize="12" Margin="10,18,10,0"/>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Direct Apple AirDrop · Your files stay on your devices." Foreground="#63768B" FontSize="12" Margin="2,20,0,0" TextWrapping="Wrap"/>
    <Border x:Name="ConsentPanel" Grid.RowSpan="4" Background="#F0FFFFFF" CornerRadius="16" Visibility="Collapsed" Padding="50">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="An incoming drop" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="ConsentText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20"/><TextBlock Text="Sender names are unverified. Accept only transfers you expect." TextAlignment="Center" TextWrapping="Wrap" Foreground="#63768B"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24"><Button Content="Decline" Click="DeclineTransfer" Margin="0,0,12,0"/><Button Content="Accept files" Click="AcceptTransfer" Background="#3569C8" Foreground="White"/></StackPanel></StackPanel>
    </Border>
  </Grid>
  </Border>
</Window>
